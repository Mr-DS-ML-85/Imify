# ---- Imify environment -----------------------------------------------
# Copy to .env and fill in. Generate a real admin key:
#   python -c "import secrets; print('sk_' + secrets.token_urlsafe(32))"

# Required: admin key for the Admin panel + admin API.
BOOTSTRAP_ADMIN_KEY=sk_change_me_generate_a_real_one

# Public base URL of this instance (only needed for live web reverse
# search of uploaded images). Leave empty on a LAN/private box.
PUBLIC_BASE_URL=

# "open" = search needs no key (home server); "key" = everything needs a key.
AUTH_MODE=open

# ---- StrikeDB ---------------------------------------------------------
STRIKEDB_PASS=
STRIKEDB_PORT=6008

# ---- SearXNG ----------------------------------------------------------
SEARXNG_SECRET=imify-searxng-secret-change-me
SEARXNG_PORT=8080
SEARXNG_QUERY_INTERVAL=5

# ---- proxify (anti-bot gateway for the Google reverse provider) -------
# Google is ONLY reachable through proxify — never direct (it blocks
# datacenter IPs). Start proxify from your checkout with the ports that do
# not collide with the rest of this stack:
#   cd reference/proxify/proxy-orchestrator
#   API_PORT=8081 PROXY_PORT=8888 REDIS_PORT=6381 docker compose up -d --build
# (The compose defaults were patched so 8081/8888/6381 are the safe defaults.)
PROXIFY_FETCH_URL=http://127.0.0.1:8081
# CONNECT tunnel — used to upload the raw bytes of images that have no public
# URL (circle-to-search). Requires proxify's CONNECT proxy on 8888.
FETCH_PROXY_URL=http://127.0.0.1:8888
# Force proxify's real-browser path (gui_chrome) for Google — reliable but
# slower. Set false to let proxify's fast TLS strategies try first.
PROXIFY_USE_BROWSER=true
# Byte-upload reverse search (Google /searchbyimage/upload via proxify):
# this is what lets a NEW image with no online links be searched at all.
GOOGLE_UPLOAD_ENABLED=true

# Netscape cookie file with the real user session (proxify exports it via
# scripts/brave_cookies.py — the 1,500+ cookies it holds). Candidate
# verification attaches the cookies for the target host, so hotlink-protected
# CDNs like Facebook (lookaside.fbsbx.com / scontent.*.fbcdn.net) resolve to
# actual pixels instead of login stubs. Facebook comet photo pages are
# rendered through proxify's gui_chrome (PROXIFY_FETCH_URL) to reveal the
# signed image URL, then fetched with cookies through the tunnel.
COOKIE_FILE=

# ---- App / pipeline ---------------------------------------------------
APP_PORT=8000
GATEWAY_WORKERS=2
INDEXER_FETCH_WORKERS=4
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600
RATE_LIMIT_PER_DAY=5000

# ---- Auto-update trackers (continuous background reverse search) ------
# Every NEW uploaded/search image gets indexed AND reverse-searched across
# the whole internet on a schedule; every new match is ingested, so the
# index auto-updates over time (TinEye-style).
AUTO_TRACK_SEARCHES=true
TRACKER_INTERVAL_SECONDS=3600
# Tracker candidates are downloaded and fused-hash-verified against the
# tracked image before ingestion — unrelated images never pollute the index.
TRACKER_VERIFY_CANDIDATES=true

# ---- Hash verdict (TinEye model) ---------------------------------------
# Engines (SearXNG / Google) only FIND candidate URLs; every candidate is
# downloaded and fused-hash-verified against the query before it is reported
# as a match (Google limits face results — our own hashes are the judge).
# Candidates that fail to fetch or don't match are listed as "unverified"
# and never count as found.
WEB_VERIFY_CANDIDATES=true
WEB_VERIFY_CONCURRENCY=10
WEB_VERIFY_MAX_CANDIDATES=80
# Max proxify browser renders per search (Facebook comet photo pages are
# JS-only; each render costs ~10s through the shared Chrome).
WEB_VERIFY_RENDER_MAX=4
# Fused distance bands: 0.5*pHash + 0.3*dHash + 0.2*aHash (each 0-1).
# Loosened so real re-encoded/download copies of the SAME image verify as
# exact/near (with confidence %) instead of being dropped as "unverified".
FUSED_EXACT_THRESHOLD=0.14
FUSED_NEAR_THRESHOLD=0.35
# Hamming threshold (bits) for consolidating same-photo results from multiple
# sites into one card with a growing "found on N sites" list. 0 = disable.
SEARCH_DEDUP_THRESHOLD=8
# Unverified candidates closer than this fused distance are still shown as
# visually-similar previews; farther ones are treated as noise and dropped.
WEB_UNVERIFIED_MAX_FUSED=0.36
# De-rank Bing previews (its visual-search returns junk for logos/faces).
WEB_ENGINE_BING_PENALTY=1.35

# ---- Optional AI layer (OpenAI-compatible: llama.cpp / NVIDIA NIM / Ollama) --
# Leave AI_OLLAMA_URL empty to disable AI entirely (pure perceptual pipeline).
# When set, Imify auto-captions indexed images and can answer natural-language
# searches via /v1/search/text. Any OpenAI-wire server works:
#   llama.cpp embed:   http://127.0.0.1:8374/v1
#   NVIDIA NIM vision: https://integrate.api.nvidia.com/v1  (AI_API_KEY required)
#   Ollama:            http://127.0.0.1:11434/v1
AI_OLLAMA_URL=
AI_BASE_URL=
# Hosted vision endpoint, distinct from the local embed server (leave empty to
# caption via AI_BASE_URL too).
AI_CAPTION_URL=
AI_API_KEY=
AI_CAPTION_MODEL=meta/llama-3.2-11b-vision-instruct
AI_EMBED_MODEL=nomic-embed-text-v1.5.Q8_0.gguf
AI_CAPTION_ON_INDEX=false

# ---- Optional OCR layer (Tesseract, self-hosted) ------------------------
# Extracts visible text from indexed images (logos/memes/screenshots) and
# enables /v1/search/ocr. Requires: apt install tesseract-ocr + pip install
# pytesseract. Disabled by default — zero native deps.
OCR_ENABLED=false
OCR_LANG=eng
